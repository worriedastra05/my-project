; CrossSectionalMomentumEA - preset "FX intraday on M5"
;
; ============================== WARNING ==============================
; This preset exists so you can SEE THE MECHANICS WORK in a short M5
; backtest. It is NOT the researched strategy.
;
; Every study behind this EA (Jegadeesh-Titman 1993, Menkhoff et al.
; 2012, Barroso-Santa-Clara 2015) measures momentum over WEEKS TO
; MONTHS and rebalances MONTHLY. There is no published evidence for a
; 4-hour cross-sectional currency momentum signal, and at this cadence
; the bid-ask spread will very likely dominate any edge: the strategy
; reconstitutes 8x per day instead of once a month.
;
; Use this to verify the plumbing, then move to
; CSMOM_FX_G10_Monthly.set for anything you intend to trade.
; =====================================================================
;
; Signal    : 48 x M5 bars  = 4 hours of formation
; Rebalance : every 12 x M5 bars = once per hour
; History   : needs only ~290 M5 bars (about one trading day) to start
;
; --- 1. Universe ---
InpSymbols=EURUSD,GBPUSD,AUDUSD,NZDUSD,USDCAD,USDCHF,USDJPY
InpSymbolSuffix=
InpUniverseMode=0
; --- 2. Momentum signal ---
InpSignalTF=5
InpFormationBars=48
InpSkipBars=0
InpSignalType=1
InpVolLookback=288
InpLongCount=2
InpShortCount=2
InpUseDualMomentum=false
InpMinAbsScore=0.0
; --- 3. Rebalancing ---
InpRebalanceMode=3
InpRebalanceEveryN=12
InpRebalanceHour=21
InpRebalanceMinute=0
InpRebalanceDOW=1
InpRebalanceDOM=1
InpRebalanceOnStart=true
InpResizeExisting=false
InpResizeTolPct=35.0
; --- 4. Sizing / risk ---
InpSizingMode=2
InpFixedLot=0.1
InpRiskPctPerLeg=0.25
InpPortfolioRiskPct=1.5
InpUseVolTarget=true
InpTargetVolAnnual=10.0
InpVolScaleMin=0.25
InpVolScaleMax=2.0
InpMaxGrossLeverage=4.0
InpMaxMarginPct=30.0
; --- 5. Stops ---
InpStopTF=15
InpATRPeriod=14
InpSL_ATR=2.0
InpTP_ATR=4.0
InpUseBreakEven=true
InpBE_Trigger_ATR=1.0
InpBE_Offset_ATR=0.1
InpUseTrailing=true
InpTrailStart_ATR=1.5
InpTrail_ATR=1.75
; --- 6. Safety ---
; Intraday ATR is small relative to the spread, so this limit must be
; much looser than on D1 or every entry gets filtered out.
InpMaxSpreadATRPct=30.0
InpMaxDailyLossPct=3.0
InpMaxDrawdownPct=15.0
InpCloseAllOnHalt=true
InpMagic=20260928
InpSlippage=30
InpTradeComment=CSMOM5
InpVerboseLog=true
InpRunDiagnostics=true
InpShowPanel=true
